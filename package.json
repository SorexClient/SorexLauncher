{
  "name": "sorex-launcher",
  "private": true,
  "version": "2.0.5",
  "author": {
    "name": "Sorex Launcher Team",
    "email": "support@sorexclient.com"
  },
  "homepage": "https://github.com/SorexClient/SorexLauncher",
  "description": "Premium Minecraft Launcher",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_URL=http://localhost:5173 electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "cross-env CSC_SKIP_SIGNING=true electron-builder --win --dir",
    "build:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux deb rpm",
    "build:linux:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux dir",
    "dist": "powershell -ExecutionPolicy Bypass -Command \"taskkill /F /IM 'Sorex Launcher.exe' /T; Start-Sleep -s 2; if (Test-Path release) { Remove-Item -Recurse -Force release }; pnpm run build:vite; pnpm run build:electron\"",
    "dist:linux": "pnpm run build:vite && pnpm run build:linux",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.sorexclient.launcher",
    "productName": "Sorex Launcher",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "public/logo.png",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "public/logo.png",
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Game",
      "maintainer": "Sorex Launcher Team <support@sorexclient.com>"
    },
    "nsis": {
      "oneClick": false
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.2",
    "rimraf": "^6.1.3",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "discord-rpc": "^4.0.1",
    "lucide-svelte": "^1.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  }
}
